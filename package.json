{
  "name": "ai-review-verifier",
  "version": "0.9.0",
  "description": "A GitHub Action that checks code diffs in Pull Requests and automatically comments on potential issues.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccx-330/ai-review-verifier.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build lib/index.js --source-map --license licenses.txt",
    "check-dist": "npm run build && npm run package && git diff --exit-code dist"
  },
  "keywords": [
    "github-action",
    "code-review",
    "pull-request",
    "typescript",
    "automation"
  ],
  "author": "ccx-330",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
